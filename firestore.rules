rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per family. The 12-character family code is the secret:
    // anyone signed in (anonymously) who knows it can read and edit, nobody can list families.
    match /families/{familyId} {
      allow get, create, update: if request.auth != null && familyId.size() == 12;
    }
    // JC Racer (the kids' racing game) shares this Firebase project: same idea, own collection.
    // The family document holds the drivers, each record ghost is a document of its own.
    match /racers/{familyId} {
      allow get, create, update: if request.auth != null && familyId.size() == 12;
      match /ghosts/{ghostId} {
        allow get, create, update: if request.auth != null && familyId.size() == 12;
      }
    }
  }
}
